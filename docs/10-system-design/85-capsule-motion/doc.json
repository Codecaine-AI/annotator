          "insert": "Film and Lint the Capsule"
        }
      ],
      "children": []
    },
    "p-record": {
      "id": "p-record",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "perf/pill/record.sh <binary> <dir> [--time-scale 0.25] [scene…]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " films each lab scene and runs motion-lint over the traces. With no scene it films all seven. The outline shows one run."
        }
      ],
      "children": []
    },
    "po-record": {
      "id": "po-record",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Record the Pill Scenes",
            "steps": [
              {
                "text": "Check the Screen",
                "steps": [
                  {
                    "text": "Run `perf/screen-guard.sh`"
                  },
                  {
                    "text": "The guard refuses on the Studio, so a run never wakes a desk display",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "For Each Scene",
                "steps": [
                  {
                    "text": "Start `scrawl lab pill <scene> --trace <dir>/runs/<scene>/trace/<scene>.jsonl`",
                    "trace": true
                  },
                  {
                    "text": "Read the capsule region from the lab's log for up to 1.5 s"
                  },
                  {
                    "text": "If neither the log nor `$REGION` gives a region",
                    "steps": [
                      {
                        "text": "Stop the lab"
                      },
                      {
                        "text": "Exit with an error"
                      }
                    ]
                  },
                  {
                    "text": "Start `screencapture -v` on that region into `<dir>/<scene>.mov`",
                    "trace": true
                  },
                  {
                    "text": "Wait for the lab to quit"
                  },
                  {
                    "text": "Stop the screen recording"
                  }
                ]
              },
              {
                "text": "Lint the Traces",
                "steps": [
                  {
                    "text": "Run `motion-lint analyze <dir>` with `perf/pill/motion-lint.config.json`",
                    "trace": true
                  },
                  {
                    "text": "The config sets `launchSettleMs` to 0, because the lab already waits 0.85 s before its first step",
                    "kind": "note"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
