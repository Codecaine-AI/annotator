      "id": "callout-screen",
      "type": "callout",
      "props": {
        "tone": "warning"
      },
      "text": [
        {
          "insert": "record.sh records the real screen. Run it only on the MacBook Pro under "
        },
        {
          "insert": "/tmp/pro-gui.lock",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", never on the Studio, and never wake a display with "
