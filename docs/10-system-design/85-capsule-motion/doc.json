          "insert": "bun ~/code/open-source/motion-lint/cli/motion-lint.ts baseline <before> <after> --config perf/pill/motion-lint.config.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " diffs the two traces. "
        },
        {
          "insert": "$MOTION_LINT",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " names another motion-lint path for record.sh."
        }
      ],
      "children": []
    },
    "li-cmp-2": {
      "id": "li-cmp-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
