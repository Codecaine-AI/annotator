          "insert": "--trace <file>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " writes the motion-lint trace, the same as "
        },
        {
          "insert": "SCRAWL_MOTION_TRACE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "li-flag-2": {
      "id": "li-flag-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "--repeat <n>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plays the scene n times, default 1. A value of 0 repeats until you stop it, so you can tune while it loops."
