    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The capsule is the pill under the menu bar that shows the picker, the recording controls and the finished capture. Its springs, fades and blur all run on one animation clock that you can slow down, trace and tune while it plays. This page covers the clock and the tune file, the motion lab that replays the capsule's states, and the script that films and lints them. What the capsule shows during a recording is on "
        },
        {
          "insert": "Capture and Recording",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-capture"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
