        },
        {
          "insert": " in "
        },
        {
          "insert": "src/ui/motion.rs",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "src/ui/motion.rs"
            }
          }
        },
        {
          "insert": ", so one time scale slows every animation at once."
        }
      ],
      "children": []
    },
