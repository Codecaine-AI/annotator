          "insert": "uv run perf/pill/clips.py before.mov after.mov <out> [--slow 4] [--strip-at <s>]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " aligns both films on the capsule's first frame and stacks them, labeled, before on top. It writes "
        },
        {
          "insert": "<out>.mp4",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "<out>-slow.mp4",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and a 12-frame strip "
        },
        {
          "insert": "<out>-strip.png",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
