    "sd-open": {
      "id": "sd-open",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "System Design says what Annotator does, from the press that starts a capture to the paste that an agent reads. The outline below shows that path. The page list after it groups the 11 pages by the phase that each one covers."
        }
      ],
      "children": []
    },
    "sd-path-h": {
      "id": "sd-path-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Capture Path"
        }
      ],
      "children": []
    },
    "sd-path-p": {
      "id": "sd-path-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "One capture runs through four phases. A cabled iPhone and ScrawlKit enter at the Build phase with their own recording."
        }
      ],
      "children": []
    },
    "sd-path": {
      "id": "sd-path",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "One Capture",
            "steps": [
              {
                "text": "Record",
                "steps": [
                  {
                    "text": "Press the Record shortcut, or pick a target in the picker"
                  },
                  {
                    "text": "Record the screen video, the microphone, clicks, scrolls and ink"
                  },
                  {
                    "text": "Log the windows on screen"
                  },
                  {
                    "text": "Press the Record shortcut again to finish"
                  }
                ]
              },
              {
                "text": "Build",
                "steps": [
                  {
                    "text": "Transcribe `audio.wav`"
                  },
                  {
                    "text": "Cut keyframes on actions, marks and visual changes"
                  },
                  {
                    "text": "Draw `contact-sheet.png` and `frames/`"
                  },
                  {
                    "text": "Write `scrawl.json` and `summary.md`"
                  }
                ]
              },
              {
                "text": "Deliver",
                "steps": [
                  {
                    "text": "Copy `summary.md` to the clipboard"
                  },
                  {
                    "text": "When a destination is found, send the capture to its OpenCode session"
                  }
                ]
              },
              {
                "text": "Keep",
                "steps": [
                  {
                    "text": "Show the capture in History"
                  },
                  {
                    "text": "Shrink or remove heavy media under the retention limits"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
