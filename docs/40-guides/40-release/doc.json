        {
          "insert": ".github/workflows/release-windows.yml",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": ".github/workflows/release-windows.yml"
            }
          }
        },
        {
          "insert": ". The job also opens the welcome window on a fresh profile and keeps a screenshot."
        }
