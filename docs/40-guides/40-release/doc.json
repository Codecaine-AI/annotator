    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This guide is upstream's release process for kitlangton/scrawl. A release is one notarized Mac build, a DMG and a Sparkle zip, plus one Windows zip, all from the same tagged commit. Every change lands on "
        },
        {
          "insert": "main",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " through pull requests, the version bump and the appcast included."
        }
      ],
      "children": []
    },
    "fork": {
      "id": "fork",
      "type": "callout",
      "props": {
        "title": "Upstream process only",
        "tone": "warning"
      },
      "text": [
        {
          "insert": "Annotator does not publish releases, and the fork has no Sparkle, appcast, DMG, Homebrew cask or Windows zip. Do not run these steps from the fork."
        }
      ],
      "children": []
    },
    "fork-p": {
      "id": "fork-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Install Annotator from the repo with "
        },
        {
          "insert": "./scripts/install-app.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", as "
        },
        {
          "insert": "Build, Test, and Install",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/10-build-test-and-install"
            }
          }
        },
        {
          "insert": " shows. The steps below stay for reference and for changes sent upstream."
        }
      ],
      "children": []
    },
