    "s2c": {
      "id": "s2c",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "SCRAWL_BUILD_NUMBER=<n> \\\n  SCRAWL_SPARKLE_DIR=~/.local/share/scrawl-release/sparkle-2.9.4 \\\n  ./scripts/release-app.sh"
