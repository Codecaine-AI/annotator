    "s1b": {
      "id": "s1b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A push to a "
        },
        {
          "insert": "release/**",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " branch dry-runs the Windows job in "
