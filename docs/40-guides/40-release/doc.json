    "script-outline": {
      "id": "script-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Release Build",
            "steps": [
              {
                "text": "Prepare",
                "steps": [
                  {
                    "text": "Run `scripts/setup-sparkle.sh` for the Sparkle folder"
                  },
                  {
                    "text": "Run `cargo build --release -j 3 --offline`"
                  },
                  {
                    "text": "Assemble `dist/Scrawl.app` with Sparkle.framework and `dev.kitlangton.scrawl`"
                  }
                ]
              },
              {
                "text": "Sign",
                "steps": [
                  {
                    "text": "If the Developer ID identity is in the keychain, sign with the hardened runtime"
                  },
                  {
                    "text": "Otherwise sign ad hoc"
                  }
                ]
              },
              {
                "text": "Package",
                "steps": [
                  {
                    "text": "Create and sign the DMG"
                  },
                  {
                    "text": "If signed and the notary key exists, notarize and staple"
                  },
                  {
                    "text": "Otherwise warn that Gatekeeper blocks the download"
                  },
                  {
                    "text": "Zip the app into `dist/` and `dist/updates/`"
                  }
                ]
              },
              {
                "text": "If the Sparkle Key Is in the Keychain",
                "steps": [
                  {
                    "text": "Run `generate_appcast` over `dist/updates/`"
                  }
                ]
              },
              {
                "text": "If `site/public` Exists",
                "steps": [
                  {
                    "text": "the appcast PR later replaces this copy with the appcast from the Pro",
                    "kind": "note"
                  },
                  {
                    "text": "Copy the DMG and zip into `site/public/releases/`"
                  },
                  {
                    "text": "Copy the local appcast to `site/public/appcast.xml`"
                  }
                ]
              },
              {
                "text": "If the Mode Is Publish",
                "steps": [
                  {
                    "text": "Build and deploy the site"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
