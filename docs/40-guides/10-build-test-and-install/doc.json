    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This guide builds and tests Annotator, then installs it as a signed app so macOS keeps its permission grants across rebuilds. Agents test in Annotator Dev.app, never in the live Annotator.app, because the live app is in daily use. "
        },
        {
          "insert": "Safety and Recovery",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/30-safety-and-recovery"
            }
          }
        },
        {
          "insert": " lists what a test must never do on the real Macs."
        }
      ],
      "children": []
    },
    "bt-h": {
      "id": "bt-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Build and Test"
        }
      ],
      "children": []
    },
    "bt-p": {
      "id": "bt-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Build and test at utility priority, with 3 jobs and no network. Keep "
        },
        {
          "insert": "Cargo.toml",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "Cargo.lock",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " unchanged."
        }
      ],
      "children": []
    },
    "bt-code": {
      "id": "bt-code",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "taskpolicy -c utility cargo build -j 3 --offline\ntaskpolicy -c utility cargo test -j 3 --offline -- --test-threads=2"
        }
      ],
      "children": []
    },
