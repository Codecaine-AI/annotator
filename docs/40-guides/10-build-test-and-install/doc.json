      ],
      "children": []
    },
    "sign-1": {
      "id": "sign-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The script makes or reuses the "
        },
        {
          "insert": "Annotator Local Development",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " certificate in the login keychain. It writes its SHA-1 and keychain to "
        },
        {
          "insert": "~/.config/annotator/signing.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "sign-2": {
      "id": "sign-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "When "
        },
        {
          "insert": "signing.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " exists, the script prints the saved identity and changes nothing."
        }
      ],
      "children": []
    },
    "sign-3": {
      "id": "sign-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
