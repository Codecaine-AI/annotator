    "live-p": {
      "id": "live-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Install and start the live app only with "
        },
        {
          "insert": "./scripts/install-app.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Never run "
        },
        {
          "insert": "target/debug/scrawl",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as the background app. "
        },
        {
          "insert": "hivemind clean",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " purges "
        },
        {
          "insert": "target/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which unlinks the running binary, and "
        },
        {
          "insert": "tccd",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " then revokes Screen Recording and Microphone. The script runs these steps:"
        }
      ],
      "children": []
    },
    "live-outline": {
      "id": "live-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Install Annotator.app",
            "steps": [
              {
                "text": "Check the Signing Identity",
                "steps": [
                  {
                    "text": "If `signing.json` is missing, stop with a message to run `setup-local-signing.py`"
                  },
                  {
                    "text": "If the identity is not a SHA-1, stop"
                  },
                  {
                    "text": "If the identity is not in the keychain, stop"
                  },
                  {
                    "text": "the script never signs ad hoc",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Build and Copy",
                "steps": [
                  {
                    "text": "Run `taskpolicy -c utility cargo build -j 3 --offline`"
                  },
                  {
                    "text": "Copy `scrawl` and `scrawl-helper` into `/Applications/Annotator.app/Contents/MacOS/`"
                  },
                  {
                    "text": "Remove `Contents/Frameworks`"
                  },
                  {
                    "text": "Write `Info.plist` with bundle id `ai.codecaine.annotator`"
                  }
                ]
              },
              {
                "text": "Sign",
                "steps": [
                  {
                    "text": "Sign the helper as `ai.codecaine.annotator.helper`"
                  },
                  {
                    "text": "Sign the app as `ai.codecaine.annotator`"
                  },
                  {
                    "text": "each designated requirement names only the identifier and the certificate leaf",
                    "kind": "note"
                  },
                  {
                    "text": "Run `codesign --verify --strict` on the app"
                  }
                ]
              },
              {
                "text": "If `SCRAWL_NO_LAUNCH` Is 1",
                "steps": [
                  {
                    "text": "Stop before the links and the restart"
                  }
                ]
              },
              {
                "text": "Link and Restart",
                "steps": [
                  {
                    "text": "Link `~/bin/scrawl` and `/usr/local/bin/scrawl` to the app's binary"
                  },
                  {
                    "text": "Quit Scrawl.app, Annotator.app and any `target/debug/scrawl`"
                  },
                  {
                    "text": "If an old app still runs after 2 s, stop with an error"
                  },
                  {
                    "text": "Open Annotator.app"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
