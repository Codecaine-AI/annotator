      "id": "hk-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "routing::Hooks",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "src/routing.rs",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "src/routing.rs"
            }
          }
        },
        {
          "insert": " covers dev-site routing: "
        },
        {
          "insert": "sdk",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " looks up a registered tab, "
        },
        {
          "insert": "listener_dir",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds the project behind a port, and "
        },
        {
          "insert": "api",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " makes one OpenCode "
