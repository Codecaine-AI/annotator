    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Tests of Annotator must not touch Kit's real grants, displays, speakers, or OpenCode sessions. This guide gives the safe way to test each of them and the steps to re-send a capture that did not arrive. Read it before you test permissions, displays, audio, or delivery."
        }
      ],
      "children": []
    },
    "rules-h": {
      "id": "rules-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
