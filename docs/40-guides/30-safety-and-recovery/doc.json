      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Run "
        },
        {
          "insert": "scrawl send <bundle>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " without "
        },
        {
          "insert": "--session",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The command sends the bundle to its recorded destination."
        }
      ],
      "children": [
        "rc-4a",
        "rc-4b"
