          "insert": "Test Without Touching Kit's Macs"
        }
      ],
      "children": []
    },
    "rules-p": {
      "id": "rules-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each row names an action that is never allowed and the safe action to use instead. The sections below the table give the details."
        }
      ],
      "children": []
    },
