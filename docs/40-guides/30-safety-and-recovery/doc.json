      },
      "text": [
        {
          "insert": "If the bundle records no destination and the owning app is unclear, ask the user and stop."
        }
      ],
      "children": [
        "rc-2a"
      ]
    },
    "rc-2a": {
      "id": "rc-2a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Do not guess from the session on screen or from recent activity. Without a destination, "
        },
        {
          "insert": "scrawl send",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " picks the most recent active session."
        }
      ],
      "children": []
    },
