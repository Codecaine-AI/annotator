        {
          "insert": "/tmp/pro-gui.lock",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", on a virtual display, or in a macvm VM."
        }
      ],
      "children": []
    },
    "sg-1a": {
      "id": "sg-1a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "perf/screen-guard.sh",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "perf/screen-guard.sh"
            }
          }
        },
        {
          "insert": " exits non-zero when the Mac's screen must not be used for a real-screen capture. It never wakes a display."
