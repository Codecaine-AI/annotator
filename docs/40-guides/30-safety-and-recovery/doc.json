    "hk-p": {
      "id": "hk-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A test never posts to a real OpenCode session. Two hook structs hold the steps that reach outside the process, and a test replaces them."
        }
      ],
      "children": []
    },
    "hk-1": {
      "id": "hk-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "IngestHooks",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "src/phone.rs",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "src/phone.rs"
            }
          }
        },
        {
          "insert": " covers a ScrawlKit ingest: "
        },
        {
          "insert": "resolve",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " picks the session, "
        },
        {
          "insert": "build",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " makes the bundle, and "
        },
        {
          "insert": "forward",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " sends it."
        }
      ],
      "children": []
    },
