    "eval-p": {
      "id": "eval-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "To compare a summary experiment on real captures, run "
        },
        {
          "insert": "scripts/agent-eval.sh [--experiment NAME] [--out DIR] [bundle…]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It reprocesses each bundle with and without the flag and writes "
        },
        {
          "insert": "before.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "after.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", both contact sheets and the frames for each bundle, plus an "
        },
        {
          "insert": "index.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Both summaries use the baseline run's transcript. Data that a capture recorded live, such as Accessibility lookups and page events, shows only on captures made with the flag on."
        }
      ],
      "children": []
    },
