    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An experiment is a named flag that keeps a change to what users get off until it is turned on in "
        },
        {
          "insert": "config.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The feature map is the list of every user-facing feature with its status, and a test keeps it in step with the code. This page records how both work, in "
        },
        {
          "insert": "src/handoff.rs",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "src/handoff.rs"
            }
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "src/feature_map.rs",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "src/feature_map.rs"
            }
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "site/src/features.json",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "site/src/features.json"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
