    "exp-p": {
      "id": "exp-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Code asks "
        },
        {
          "insert": "handoff::experiment(\"<name>\")",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Every experiment is off unless one of the two sources below turns it on. The config file is "
        },
        {
          "insert": "~/.config/scrawl/config.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for the live app and "
        },
        {
          "insert": "~/.config/scrawl-dev/config.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for Annotator Dev."
        }
      ],
      "children": []
    },
    "exp-outline": {
      "id": "exp-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Experiment Lookup",
            "steps": [
              {
                "text": "If `enable_experiment` Named the Flag in This Process",
                "steps": [
                  {
                    "text": "Return on"
                  }
                ]
              },
              {
                "text": "If the Code Runs in a Test",
                "steps": [
                  {
                    "text": "tests never read the config file",
                    "kind": "note"
                  },
                  {
                    "text": "Return off"
                  }
                ]
              },
              {
                "text": "Read `\"experiments\"` from the config file"
              },
              {
                "text": "Return the flag's value, or off when it is absent"
              }
            ]
          }
        ]
      },
      "children": []
    },
    "exp-enable": {
      "id": "exp-enable",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "To turn one on for every capture, add it under "
        },
        {
          "insert": "\"experiments\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", such as "
        },
        {
          "insert": "\"experiments\": {\"liveTranscribe\": true}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". To try one on a single bundle, pass "
        },
        {
          "insert": "--experiment <name>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "scrawl reprocess",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "scrawl inspect",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The flag is repeatable, and each one calls "
        },
        {
          "insert": "enable_experiment",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for that run only."
        }
      ],
      "children": []
    },
