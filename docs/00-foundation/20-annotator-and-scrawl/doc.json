    "id-p": {
      "id": "id-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each app takes its paths, port, shortcuts, and command name from its bundle id, so both apps run at the same time without shared state. "
        },
        {
          "insert": "Variant::current",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "src/app_identity.rs",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "src/app_identity.rs"
            }
          }
        },
        {
          "insert": " reads the id once, from the "
        },
        {
          "insert": "Info.plist",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of the "
        },
        {
          "insert": ".app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " that holds the executable. The table compares the two apps."
        }
      ],
      "children": []
    },
