    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Annotator is Codecaine's fork of kitlangton/scrawl by Kit Langton, forked at v0.3.14. The app shows the name Annotator, but the command, the bundle format, and the data folders keep the Scrawl name. Two copies run on one Mac: the live Annotator.app that Ford uses every day and Annotator Dev.app for agent tests. This page lists the names kept from Scrawl and the identity of each app."
        }
      ],
      "children": []
    },
    "fork-h": {
      "id": "fork-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Fork"
        }
      ],
      "children": []
    },
    "fork-p": {
      "id": "fork-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The fork ships only as a local build from this repo. Upstream's app can stay installed beside it."
        }
      ],
      "children": []
    },
    "fg1": {
      "id": "fg1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Distribution",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "f1",
        "f2"
      ]
    },
    "f1": {
      "id": "f1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The fork has no DMG, no Homebrew cask, and no Sparkle update. "
        },
        {
          "insert": "Build, Test, and Install",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/10-build-test-and-install"
            }
          }
        },
        {
          "insert": " gives the install steps."
        }
      ],
      "children": []
    },
    "f2": {
      "id": "f2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The Windows build is upstream's. The fork does not publish Windows releases."
        }
      ],
      "children": []
    },
    "fg2": {
      "id": "fg2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Upstream Scrawl.app",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "f3",
        "f4"
      ]
    },
    "f3": {
      "id": "f3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Upstream's "
        },
        {
          "insert": "/Applications/Scrawl.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and its data stay on disk. "
        },
        {
          "insert": "scripts/install-app.sh",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/install-app.sh"
            }
          }
        },
        {
          "insert": " never deletes them."
        }
      ],
      "children": []
    },
    "f4": {
      "id": "f4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Scrawl.app and the live Annotator.app share the shortcut and the captures folder, so only one can run. The live install quits a running Scrawl.app."
        }
      ],
      "children": []
    },
