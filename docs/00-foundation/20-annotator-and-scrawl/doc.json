      "children": []
    },
    "d1b": {
      "id": "d1b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A development build never reads or writes the live app's state."
        }
      ],
      "children": []
    },
    "d2": {
      "id": "d2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Dev's shortcuts use "
        },
        {
          "insert": "⌃⌥",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " because the live app's default Record and Paste shortcuts also answer to the three aliases. Dev has no aliases, since they would be the live app's keys."
        }
      ],
      "children": []
    },
    "d3": {
      "id": "d3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Agents test in Annotator Dev.app and never in the live app. Open it with "
        },
        {
          "insert": "open -a \"$HOME/Applications/Annotator Dev.app\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "d4": {
