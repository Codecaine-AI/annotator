    "pr-p": {
      "id": "pr-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Five principles decide what a change to Annotator must keep. They come in order of weight: the human's time comes first."
        }
      ],
      "children": []
    },
    "p1": {
      "id": "p1",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The human's time is the scarce resource.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "p1a",
        "p1b"
      ]
    },
    "p1a": {
      "id": "p1a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Starting ("
        },
        {
          "insert": "⌥⇧S",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), marking ("
        },
        {
          "insert": "⇧",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), and delivering (auto-routing or "
        },
        {
          "insert": "⌥⇧V",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") must feel instant."
        }
      ],
      "children": []
    },
    "p1b": {
      "id": "p1b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Each of the three actions must take as few steps as possible."
        }
      ],
      "children": []
    },
    "p2": {
      "id": "p2",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Do not make the agent guess what Scrawl can capture.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "p2a",
        "p2b",
        "p2c"
      ]
    },
    "p2a": {
      "id": "p2a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The OS, the window server, the Accessibility tree, the browser page, or the host app can know which window, element, URL, or session is on screen. Record that fact."
        }
      ],
      "children": []
    },
    "p2b": {
      "id": "p2b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Do not leave the agent to infer the fact from pixels and from words such as \"this part\" or \"here\"."
        }
      ],
      "children": []
    },
    "p2c": {
      "id": "p2c",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "App State and Privacy",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/40-app-state-and-privacy"
            }
          }
        },
        {
          "insert": " holds what Annotator records and the privacy policy for each stored string."
        }
      ],
      "children": []
    },
    "p3": {
      "id": "p3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Images stay visual and text carries meaning.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "p3a",
        "p3b",
        "p3c",
        "p3d"
      ]
    },
    "p3a": {
      "id": "p3a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "contact-sheet.png",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "frames/*.png",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " show the screen, the red ink, the click ripples, and the number of each keyframe in a small white corner chip."
        }
      ],
      "children": []
    },
    "p3b": {
      "id": "p3b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The images have no "
        },
        {
          "insert": "#",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", no time, no rasterized captions, and no card chrome."
        }
      ],
      "children": []
    },
    "p3c": {
      "id": "p3c",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "summary.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the clipboard carry the time-aligned transcript, the interaction events, and the absolute file paths as plain text. The text pastes cleanly into a terminal or a GUI composer."
        }
      ],
      "children": []
    },
    "p3d": {
      "id": "p3d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Keyframes and Images",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-keyframes-and-images"
            }
          }
        },
        {
          "insert": " holds the details."
        }
      ],
      "children": []
    },
    "p4": {
      "id": "p4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Spend the agent's context where the signal is.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "p4a",
        "p4b",
        "p4c"
      ]
    },
    "p4a": {
      "id": "p4a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Cut keyframes only on real actions, marks, or visual changes. Never cut one on a speech pause over a static screen."
        }
      ],
      "children": []
    },
    "p4b": {
      "id": "p4b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Crop each image to the active region, and keep the full frames on disk."
        }
      ],
      "children": []
    },
    "p4c": {
      "id": "p4c",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Point the agent at "
        },
        {
          "insert": "scrawl zoom",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for a closer look around a moment."
        }
      ],
      "children": []
    },
    "p5": {
      "id": "p5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Inspect real bundles after every change.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "p5a",
        "p5b",
        "p5c"
      ]
    },
    "p5a": {
      "id": "p5a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "After each change to Annotator, and after Kit tests a capture, read the latest bundles in "
        },
        {
          "insert": "~/Library/Application Support/scrawl/captures/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Annotator Dev.app writes to "
        },
        {
          "insert": "~/Library/Application Support/scrawl-dev/captures/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "p5b": {
      "id": "p5b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Read both the text, "
        },
        {
          "insert": "summary.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "scrawl.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the images, "
        },
        {
          "insert": "contact-sheet.png",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "frames/*.png",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "p5c": {
      "id": "p5c",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Report each concrete improvement you see in the output or the UX."
        }
      ],
      "children": [
        "p5c1",
        "p5c2"
      ]
    },
    "p5c1": {
      "id": "p5c1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Output problems include noisy text in "
        },
        {
          "insert": "summary.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a low-density contact sheet, a keyframe cut on a speech pause, and a ghost or misaligned stroke."
        }
      ],
      "children": []
    },
    "p5c2": {
      "id": "p5c2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "UX problems include slow startup, slow post-processing, and paste friction."
        }
      ],
      "children": []
    }
  }
