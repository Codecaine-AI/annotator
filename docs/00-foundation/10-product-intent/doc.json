    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Annotator is the human-to-agent half of a feedback loop. The agent builds, the human looks, points, talks, and draws, and the agent understands what was meant and acts. A capture records the screen, the voice, the cursor, the clicks, and the "
        },
        {
          "insert": "⇧",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ink, and Annotator compiles it into a compact "
        },
        {
          "insert": ".scrawl",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " bundle. This page states what the product is for and the five principles that every change keeps."
        }
      ],
      "children": []
    },
    "loop-h": {
      "id": "loop-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Feedback Loop"
        }
      ],
      "children": []
    },
    "loop-p": {
      "id": "loop-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "One pass of the loop goes from a change the agent made to the next change the agent makes. The human shows the problem instead of describing it."
        }
      ],
      "children": []
    },
    "loop-outline": {
      "id": "loop-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Feedback Loop",
            "steps": [
              {
                "text": "Agent Builds",
                "steps": [
                  {
                    "text": "The agent changes an app or a page"
                  }
                ]
              },
              {
                "text": "Human Shows",
                "steps": [
                  {
                    "text": "Start a capture with `⌥⇧S`, a cabled iPhone, or ScrawlKit"
                  },
                  {
                    "text": "Talk about what is on the screen"
                  },
                  {
                    "text": "Point and click at the parts that matter"
                  },
                  {
                    "text": "Hold `⇧` to draw red ink on the screen"
                  },
                  {
                    "text": "Finish the capture"
                  }
                ]
              },
              {
                "text": "Annotator Compiles",
                "steps": [
                  {
                    "text": "Cut keyframes on real actions, marks, and visual changes"
                  },
                  {
                    "text": "Write the `.scrawl` bundle to the captures folder"
                  }
                ]
              },
              {
                "text": "Agent Acts",
                "steps": [
                  {
                    "text": "Deliver the bundle by auto-routing or `⌥⇧V`"
                  },
                  {
                    "text": "The agent reads `contact-sheet.png` and `summary.md`"
                  },
                  {
                    "text": "The agent looks closer with `scrawl zoom`"
                  },
                  {
                    "text": "The agent changes the app or page again"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
    "entry-h": {
      "id": "entry-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
